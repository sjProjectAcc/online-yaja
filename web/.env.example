# 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 git에 올라가지 않는다).
# 비워 두면 "로컬 테스트" 모드: 같은 브라우저의 탭끼리만 P2P 연결된다.

# Supabase 프로젝트 설정 > API 에서 복사 (anon 키는 공개돼도 되는 키. service_role 키는 절대 넣지 말 것)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (선택) TURN 중계 서버. 통신사 LTE·학교 와이파이처럼 P2P 직접 연결이 막히는 곳에서 필요
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
